{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HumC",
  "scopeName": "source.humc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#function-declaration" },
    { "include": "#variable-declaration" },
    { "include": "#control-keywords" },
    { "include": "#builtin-functions" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.humc",
          "match": "//.*$"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.humc",
          "match": "^\\s*#\\s*(?:include|define|undef|if|ifdef|ifndef|elif|else|endif|pragma|error|line)\\b.*$",
          "captures": {
            "0": { "name": "meta.preprocessor.humc" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.humc",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.humc" }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.humc" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.humc",
          "match": "\\\\(?:[abfnrtv\\\\\"']|[0-7]{1,3}|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.humc",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.humc" }
      },
      "end": "'|$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.humc" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.humc",
          "match": "\\\\(?:[abfnrtv\\\\\"']|[0-7]{1,3}|x[0-9A-Fa-f]{1,2})"
        }
      ]
    },
    "function-declaration": {
      "name": "meta.function.declaration.humc",
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.humc" },
        "2": { "name": "entity.name.function.humc" }
      }
    },
    "variable-declaration": {
      "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.variable.humc" },
        "2": { "name": "variable.other.definition.humc" }
      }
    },
    "control-keywords": {
      "name": "keyword.control.humc",
      "match": "\\b(?:if|elif|else|while|for|in|break|continue|return|switch|case|default|try|catch|finally)\\b"
    },
    "builtin-functions": {
      "name": "support.function.builtin.humc",
      "match": "\\b(?:print|input)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.humc",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.humc",
          "match": "\\b(?:null|NULL|nil)\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.humc",
      "match": "\\b(?:void|bool|char|short|int|long|float|double|signed|unsigned|const|volatile|size_t|intptr_t|uintptr_t|u?int(?:8|16|32|64)_t)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.humc",
          "match": "\\b0[xX][0-9A-Fa-f]+[uUlL]*\\b"
        },
        {
          "name": "constant.numeric.binary.humc",
          "match": "\\b0[bB][01]+[uUlL]*\\b"
        },
        {
          "name": "constant.numeric.float.humc",
          "match": "\\b(?:[0-9]+\\.(?!\\.)[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[fFlL]?\\b"
        },
        {
          "name": "constant.numeric.integer.humc",
          "match": "\\b[0-9]+[uUlL]*\\b"
        }
      ]
    },
    "function-calls": {
      "name": "entity.name.function.call.humc",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.humc",
      "match": "\\.\\.|\\+\\+|--|->|==|!=|<=|>=|&&|\\|\\||<<|>>|[=+*/%<>!&|^~?-]"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.humc",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.humc",
          "match": ":"
        },
        {
          "name": "punctuation.section.brackets.humc",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
